# Originais pesados das fotos do site principal. O repositório é público e
# a Vercel publica /public inteiro: original de 19 MB aqui é 19 MB que
# todo mundo baixa por engano. As versões que o site usa ficam ao lado.
#   foto angelo.png  1.228 KB  ->  angelo-vinci.jpg  109 KB
public/imagens/DSC09066.JPEG
public/imagens/foto angelo.png

# Originais pesados das fotos. O site usa as versões otimizadas ao lado.
# Se quiser versionar os originais também, apague estas duas linhas.
public/paginas-que-vendem/imagens/angelo-final.png
public/paginas-que-vendem/imagens/vincy socyete.JPEG
public/paginas-que-vendem/imagens/imagefinal.png
public/paginas-que-vendem/imagens/ipad.png
public/paginas-que-vendem/imagens/ipad-web.png

# Prints originais dos sites: 1920px de largura e ate 20.000px de altura,
# somam uns 75 MB. O site usa as versoes de /imagens/sites/web.
public/paginas-que-vendem/imagens/sites/*.png
public/paginas-que-vendem/imagens/sites/*.jpg

# Originais dos banners. O site usa as versoes otimizadas ao lado.
public/paginas-que-vendem/imagens/banner-seo.png
public/paginas-que-vendem/imagens/bannerheromobile.png

