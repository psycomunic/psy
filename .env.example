# =====================================================================
# Psy Comunic - variaveis de ambiente
#
# Copie para .env.local e preencha. O .env.local NAO vai para o git.
#
# Enquanto as duas primeiras estiverem vazias, a area logada (/entrar e
# /painel) responde 404 em producao. Isso e proposital: sem banco nao ha
# autenticacao possivel, e tela de login que nao autentica e pior que
# nenhuma tela.
# =====================================================================

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# SERVICE ROLE: passa por cima de TODO o RLS.
#
# NUNCA coloque o prefixo NEXT_PUBLIC_ nesta. O prefixo publica a
# variavel no bundle do navegador, e esta chave num navegador entrega o
# banco inteiro: faturamento de todos os clientes e os tokens de anuncio
# deles.
#
# So a rotina de sincronizacao de metricas e o convite de usuario usam.
# ---------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Integracoes de metricas (fase posterior)
#
# O token de desenvolvedor do Google Ads e a analise do app na Meta
# levam dias ou semanas de aprovacao e nao dependem do nosso codigo.
# Vale abrir os dois pedidos antes de comecar a integracao.
# ---------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

META_APP_ID=
META_APP_SECRET=

# URL absoluta do site, usada nos metadados de compartilhamento.
NEXT_PUBLIC_SITE_URL=https://psycomunic.com.br

# Segredo da rota /api/ingestao, que recebe metrica de fora.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Minimo de 24 caracteres: abaixo disso a rota se recusa a subir.
INGESTAO_TOKEN=

# Chave AES-256 (32 bytes em base64url) que cifra os tokens da agencia.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NUNCA guarde esta chave no banco: e ela que faz um dump de banco nao
# virar acesso as contas de anuncio dos clientes.
CRIPTO_CHAVE=
